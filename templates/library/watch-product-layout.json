>\n<p class=\"has-ast-global-color-4-color has-text-color has-link-color has-medium-font-size\">Elevate your product pages without touching a single line of code. Noorifa Core gives you a full library of premade WooCommerce layouts and conversion-ready blocks — gallery, tabs, reviews, urgency countdowns and more — so your store looks this good in minutes, not weeks.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:media-text --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-tabs /-->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-reviews /-->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|20\",\"right\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--20);padding-right:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--20)\"><!-- wp:noorifa-core/related-products {\"columns\":3,\"fontSize\":\"medium\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->"
