  "content": "<!-- wp:noorifa-core/hero {\"backgroundImage\":{\"url\":\"http://localhost/noorblocks/wp-content/uploads/2026/07/baby_s2.webp\",\"id\":218},\"overlayOpacity\":34,\"headingFontSize\":\"52px\",\"subheadingFontSize\":\"20px\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"7.46rem\",\"bottom\":\"7.46rem\",\"left\":\"10rem\",\"right\":\"10rem\"},\"margin\":{\"right\":\"0\",\"left\":\"0\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}}},\"textColor\":\"ast-global-color-4\"} -->\n<div class=\"wp-block-noorifa-core-hero has-text-align-center has-ast-global-color-4-color has-text-color has-link-color\" style=\"margin-right:0;margin-left:0;padding-top:7.46rem;padding-right:10rem;padding-bottom:7.46rem;padding-left:10rem;background-image:url(http://localhost/noorblocks/wp-content/uploads/2026/07/baby_s2.webp);background-size:cover;background-position:center;position:relative\"><div class=\"noorifa-core-hero__overlay\" style=\"background-color:#000000;opacity:0.34\"></div><div class=\"noorifa-core-hero__content is-boxed\" style=\"max-width:700px\"><h1 class=\"noorifa-core-hero__heading\" style=\"font-size:52px\"><strong>Soft and Safe</strong></h1><p class=\"noorifa-core-hero__subheading\" style=\"font-size:20px\">84% of your daily energy is drained when your immune system is compromised†. Most people don’t realize their defense is failing until it’s already too late. These science-backed ingredients provide the emergency support you’re missing:</p><div class=\"noorifa-core-hero__actions\"><!-- wp:noorifa-core/button {\"url\":\"#\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-2\"}}}},\"backgroundColor\":\"ast-global-color-5\",\"textColor\":\"ast-global-color-2\"} -->\n<div class=\"wp-block-noorifa-core-button\"><a class=\"wp-block-noorifa-core-button noorifa-core-button__link has-ast-global-color-2-color has-ast-global-color-5-background-color has-text-color has-background has-link-color\" href=\"#\"><strong>BUY NOW</strong></a></div>\n<!-- /wp:noorifa-core/button --></div></div></div>\n<!-- /wp:noorifa-core/hero -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/review-carousel {\"productId\":198,\"selectedReviews\":[69,68,67,66,65]} /-->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"}} -->\n<div class=\"wp-block-group\" style=\"padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"padding\":{\"right\":\"0\",\"left\":\"0\"}}}} -->\n<div class=\"wp-block-columns\" style=\"padding-right:0;padding-left:0\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-gallery-carousel /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"0.5rem\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-category /-->\n\n<!-- wp:noorifa-core/product-title {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorifa-core/product-rating {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorifa-core/product-price {\"style\":{\"typography\":{\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorifa-core/product-short-description {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorifa-core/product-add-to-cart {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}}} /-->\n\n<!-- wp:noorifa-core/icon-list {\"rows\":[{\"icon\":\"shipping\",\"text\":\"Free Shipping and Exchanges\"},{\"icon\":\"nt-shieldCheck\",\"text\":\"Flexible and Secure Payment, Pay on Delivery\"},{\"icon\":\"thumbsUp\",\"text\":\"600,000 Happy Customers\"}],\"fontSize\":\"medium\"} /-->\n\n<!-- wp:noorifa-core/trust-badges {\"items\":[{\"icon\":\"nt-shieldCheck\",\"label\":\"Third-Party Tested\"},{\"icon\":\"nt-leaf\",\"label\":\"No Artificial\"},{\"icon\":\"nt-capsule\",\"label\":\"Vegan Friendly\"},{\"icon\":\"nt-medal\",\"label\":\"GMP Certified\"}]} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|80\",\"bottom\":\"var:preset|spacing|80\",\"left\":\"0\",\"right\":\"0\"}},\"color\":{\"gradient\":\"linear-gradient(135deg,rgb(122,171,187) 0%,rgb(38,63,72) 100%)\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group has-background\" style=\"background:linear-gradient(135deg,rgb(122,171,187) 0%,rgb(38,63,72) 100%);padding-top:var(--wp--preset--spacing--80);padding-right:0;padding-bottom:var(--wp--preset--spacing--80);padding-left:0\"><!-- wp:media-text {\"mediaId\":202,\"mediaLink\":\"http://localhost/noorblocks/?attachment_id=202\",\"linkDestination\":\"none\",\"mediaType\":\"image\"} -->\n<div class=\"wp-block-media-text is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img src=\"http://localhost/noorblocks/wp-content/uploads/2026/07/baby-4-4.webp\" alt=\"\" class=\"wp-image-202 size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:heading {\"level\":6,\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-5\"}}}},\"textColor\":\"ast-global-color-5\"} -->\n<h6 class=\"wp-block-heading has-ast-global-color-5-color has-text-color has-link-color\"><br><strong>CLINICALLY FORMULATED</strong></h6>\n<!-- /wp:heading -->\n\n<!-- wp:noorifa-core/heading {\"style\":{\"typography\":{\"fontSize\":\"48px\",\"lineHeight\":\"1.1\",\"fontWeight\":\"700\"},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}}},\"textColor\":\"ast-global-color-4\"} -->\n<h2 class=\"wp-block-noorifa-core-heading has-ast-global-color-4-color has-text-color has-link-color\" style=\"font-size:48px;font-weight:700;line-height:1.1\">Powered by<br>Nature &amp; Science</h2>\n<!-- /wp:noorifa-core/heading -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}}},\"textColor\":\"ast-global-color-4\",\"fontSize\":\"medium\"} -->\n<p class=\"has-ast-global-color-4-color has-text-color has-link-color has-medium-font-size\">The cotton long-sleeved striped t-shirt features a classic crew neckline, easy short sleeves, a slightly cropped length and a relaxed fit for a truly timeless look.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:media-text --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-reviews /-->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|20\",\"right\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--20);padding-right:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--20)\"><!-- wp:noorifa-core/related-products {\"columns\":3,\"fontSize\":\"medium\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->"
