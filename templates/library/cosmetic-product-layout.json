  "content": "<!-- wp:noorifa-core/hero {\"backgroundImage\":{\"url\":\"http://localhost/noorifa/wp-content/uploads/2026/08/banner01.jpg\",\"id\":46},\"textAlign\":\"left\",\"subheadingFontSize\":\"20px\",\"align\":\"full\",\"boxedWidth\":1200,\"style\":{\"spacing\":{\"padding\":{\"top\":\"6.98rem\",\"bottom\":\"6.98rem\"}}}} -->\n<div class=\"wp-block-noorifa-core-hero alignfull has-text-align-left\" style=\"padding-top:6.98rem;padding-bottom:6.98rem;background-image:url(http://localhost/noorifa/wp-content/uploads/2026/08/banner01.jpg);background-size:cover;background-position:center\"><div class=\"noorifa-core-hero__content is-boxed\" style=\"max-width:1200px\"><h1 class=\"noorifa-core-hero__heading\"><strong>Mid-Century Modern</strong></h1><p class=\"noorifa-core-hero__subheading\" style=\"font-size:20px\">Beat the Heat in Style: It’s time to stock up on summer essentials!</p><div class=\"noorifa-core-hero__actions\"><!-- wp:noorifa-core/button -->\n<div class=\"wp-block-noorifa-core-button\"><a class=\"wp-block-noorifa-core-button noorifa-core-button__link\">Buy Now</a></div>\n<!-- /wp:noorifa-core/button --></div></div></div>\n<!-- /wp:noorifa-core/hero -->\n\n<!-- wp:spacer {\"height\":\"60px\"} -->\n<div style=\"height:60px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/heading {\"textAlign\":\"center\",\"showSubheading\":true,\"subheading\":\"Experience radiant transformation with our powerful skincare solutions today\",\"subheadingFontSize\":\"20px\",\"fontSize\":\"x-large\"} -->\n<div class=\"wp-block-noorifa-core-heading has-text-align-center has-x-large-font-size\"><h2><strong>See the Difference</strong></h2><p class=\"noorifa-core-heading__subheading\" style=\"font-size:20px\">Experience radiant transformation with our powerful skincare solutions today</p></div>\n<!-- /wp:noorifa-core/heading -->\n\n<!-- wp:spacer {\"height\":\"36px\"} -->\n<div style=\"height:36px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/before-after {\"beforeImageId\":47,\"beforeImageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/before-cms.jpg\",\"afterImageId\":48,\"afterImageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/after-cms.jpg\",\"height\":450,\"handleColor\":\"#000000\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}}}} /-->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:spacer {\"height\":\"80px\"} -->\n<div style=\"height:80px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-gallery-carousel /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-category /-->\n\n<!-- wp:noorifa-core/product-title {\"style\":{\"typography\":{\"fontWeight\":\"700\"}},\"fontSize\":\"medium\"} /-->\n\n<!-- wp:noorifa-core/product-rating {\"showCount\":true} /-->\n\n<!-- wp:noorifa-core/product-price {\"style\":{\"typography\":{\"fontWeight\":\"700\"}},\"fontSize\":\"medium\"} /-->\n\n<!-- wp:noorifa-core/icon-list {\"rows\":[{\"icon\":\"check\",\"text\":\"Evens Skin Tone,Moisturizing,Sun Protection,Uv Protection.\"},{\"icon\":\"check\",\"text\":\"The High-resolution Clarity Of A Crystal.\"},{\"icon\":\"check\",\"text\":\"Designed To Provide A Bold, Smudge-proof Look.\"}],\"style\":{\"typography\":{\"fontSize\":\"16px\"}}} /-->\n\n<!-- wp:noorifa-core/urgency {\"type\":\"countdown\",\"countdownSource\":\"custom\",\"customDate\":\"2027-08-22T10:32\",\"boxed\":false,\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\"}}}} /-->\n\n<!-- wp:noorifa-core/product-add-to-cart /-->\n\n<!-- wp:noorifa-core/icon-list {\"rows\":[{\"icon\":\"time\",\"text\":\"\\u003cstrong\\u003eEstimated Delivery:\\u003c/strong\\u003e Up to 4 business days\"},{\"icon\":\"shipping\",\"text\":\"\\u003cstrong\\u003eFree Shipping \\u0026amp; Returns :\\u003c/strong\\u003e On all orders over $200\"}],\"style\":{\"typography\":{\"fontSize\":\"16px\"}}} /-->\n\n<!-- wp:noorifa-core/trust-badges {\"items\":[{\"icon\":\"nt-shieldCheck\",\"label\":\"100% Original\"},{\"icon\":\"currencyDollar\",\"label\":\"Lowest Price\"},{\"icon\":\"shipping\",\"label\":\"Free Shipping\"}],\"style\":{\"color\":{\"background\":\"#f8f8f8\"}},\"fontSize\":\"small\"} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"80px\"} -->\n<div style=\"height:80px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/video-testimonials {\"items\":[{\"videoType\":\"url\",\"videoUrl\":\"https://www.youtube.com/watch?v=daOPJhb7VZ0\",\"videoFileId\":0,\"videoFileUrl\":\"\",\"posterId\":64,\"posterUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/video-banner.jpg\",\"name\":\"\",\"role\":\"\"}],\"columns\":1} /-->\n\n<!-- wp:spacer {\"height\":\"78px\"} -->\n<div style=\"height:78px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-tabs {\"boxed\":false} /-->\n\n<!-- wp:spacer {\"height\":\"80px\"} -->\n<div style=\"height:80px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/heading {\"textAlign\":\"center\",\"showSubheading\":true,\"subheading\":\"Shop the Latest Styles: Stay ahead of the curve with our newest arrivals\",\"subheadingFontSize\":\"20px\",\"fontSize\":\"x-large\"} -->\n<div class=\"wp-block-noorifa-core-heading has-text-align-center has-x-large-font-size\"><h2><strong>Happy Customers</strong></h2><p class=\"noorifa-core-heading__subheading\" style=\"font-size:20px\">Shop the Latest Styles: Stay ahead of the curve with our newest arrivals</p></div>\n<!-- /wp:noorifa-core/heading -->\n\n<!-- wp:spacer {\"height\":\"48px\"} -->\n<div style=\"height:48px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/review-carousel {\"productId\":34,\"selectedReviews\":[6,5,4,3,2]} /-->\n\n<!-- wp:spacer {\"height\":\"48px\"} -->\n<div style=\"height:48px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/faq {\"boxedWidth\":1000} -->\n<div class=\"wp-block-noorifa-core-faq\"><h2 class=\"noorifa-core-faq__title\"><strong>Frequently Asked Questions</strong></h2><div class=\"noorifa-core-faq__accordion is-boxed\" style=\"max-width:1000px\"><!-- wp:noorifa-core/accordion -->\n<div data-wp-interactive=\"noorifa-core/accordion\" data-wp-context=\"{&quot;open&quot;:{&quot;ids&quot;:[]},&quot;allowMultiple&quot;:false}\" class=\"wp-block-noorifa-core-accordion is-boxed\" style=\"max-width:800px\"><!-- wp:noorifa-core/accordion-item {\"uid\":\"faq-shipping\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-shipping&quot;}\" class=\"wp-block-noorifa-core-accordion-item\"><h3 class=\"noorifa-core-accordion__heading\"><button type=\"button\" class=\"noorifa-core-accordion__toggle\" aria-controls=\"noorifa-core-accordion-panel-faq-shipping\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorifa-core-accordion__title\">How long does shipping take?</span><span class=\"noorifa-core-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorifa-core-accordion-panel-faq-shipping\" class=\"noorifa-core-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Most orders ship within 1–2 business days and arrive within 5–7 business days depending on your location.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorifa-core/accordion-item -->\n\n<!-- wp:noorifa-core/accordion-item {\"uid\":\"faq-returns\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-returns&quot;}\" class=\"wp-block-noorifa-core-accordion-item\"><h3 class=\"noorifa-core-accordion__heading\"><button type=\"button\" class=\"noorifa-core-accordion__toggle\" aria-controls=\"noorifa-core-accordion-panel-faq-returns\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorifa-core-accordion__title\">What is your return policy?</span><span class=\"noorifa-core-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorifa-core-accordion-panel-faq-returns\" class=\"noorifa-core-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>We offer a 30-day return window on unused items in their original packaging. Contact us to start a return.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorifa-core/accordion-item -->\n\n<!-- wp:noorifa-core/accordion-item {\"uid\":\"faq-international\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-international&quot;}\" class=\"wp-block-noorifa-core-accordion-item\"><h3 class=\"noorifa-core-accordion__heading\"><button type=\"button\" class=\"noorifa-core-accordion__toggle\" aria-controls=\"noorifa-core-accordion-panel-faq-international\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorifa-core-accordion__title\">Do you ship internationally?</span><span class=\"noorifa-core-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorifa-core-accordion-panel-faq-international\" class=\"noorifa-core-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Yes, we ship to most countries worldwide. International shipping rates are calculated at checkout.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorifa-core/accordion-item -->\n\n<!-- wp:noorifa-core/accordion-item {\"uid\":\"1ee30345-b1dc-4898-9ece-e7cbc8201041\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;1ee30345-b1dc-4898-9ece-e7cbc8201041&quot;}\" class=\"wp-block-noorifa-core-accordion-item\"><h3 class=\"noorifa-core-accordion__heading\"><button type=\"button\" class=\"noorifa-core-accordion__toggle\" aria-controls=\"noorifa-core-accordion-panel-1ee30345-b1dc-4898-9ece-e7cbc8201041\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorifa-core-accordion__title\">What payment methods do you accept?</span><span class=\"noorifa-core-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorifa-core-accordion-panel-1ee30345-b1dc-4898-9ece-e7cbc8201041\" class=\"noorifa-core-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorifa-core/accordion-item -->\n\n<!-- wp:noorifa-core/accordion-item {\"uid\":\"472cc8e3-1be7-49ad-9e20-50a1390a642c\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;472cc8e3-1be7-49ad-9e20-50a1390a642c&quot;}\" class=\"wp-block-noorifa-core-accordion-item\"><h3 class=\"noorifa-core-accordion__heading\"><button type=\"button\" class=\"noorifa-core-accordion__toggle\" aria-controls=\"noorifa-core-accordion-panel-472cc8e3-1be7-49ad-9e20-50a1390a642c\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorifa-core-accordion__title\">Do you sell gift cards?</span><span class=\"noorifa-core-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorifa-core-accordion-panel-472cc8e3-1be7-49ad-9e20-50a1390a642c\" class=\"noorifa-core-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorifa-core/accordion-item --></div>\n<!-- /wp:noorifa-core/accordion --></div></div>\n<!-- /wp:noorifa-core/faq -->\n\n<!-- wp:spacer {\"height\":\"48px\"} -->\n<div style=\"height:48px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/related-products /-->\n\n<!-- wp:spacer {\"height\":\"60px\"} -->\n<div style=\"height:60px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/feature-cards {\"items\":[{\"heading\":\"Flexible Payment\",\"text\":\"Choose the payment plan that works best for you.\",\"imageId\":60,\"imageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/flexible-payment.svg\"},{\"heading\":\"Best Online Support\",\"text\":\"Always available to assist with any questions or issues.\",\"imageId\":61,\"imageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/support.svg\"},{\"heading\":\"14 Day Returns\",\"text\":\"Return any item within 14 days for a full refund.\",\"imageId\":62,\"imageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/returns.svg\"},{\"heading\":\"Premium Support\",\"text\":\"Receive priority assistance from our dedicated\",\"imageId\":59,\"imageUrl\":\"http://localhost/noorifa/wp-content/uploads/2026/08/premium-support.svg\"}],\"columns\":4,\"cardBackgroundGradient\":\"linear-gradient(90deg,rgb(245,242,236) 0%,rgb(189,187,185) 100%)\",\"cardRadius\":12,\"boxed\":false,\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} /-->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->"
}