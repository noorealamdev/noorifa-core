  "content": "<!-- wp:noorifa-core/hero {\"backgroundImage\":{\"url\":\"http://localhost/noorblocks/wp-content/uploads/2026/07/backpack-hero.webp\",\"id\":213},\"overlayOpacity\":39,\"textAlign\":\"left\",\"headingFontSize\":\"52px\",\"subheadingFontSize\":\"20px\",\"boxedWidth\":930,\"style\":{\"spacing\":{\"padding\":{\"top\":\"7.95rem\",\"bottom\":\"7.95rem\",\"left\":\"0rem\",\"right\":\"0rem\"},\"margin\":{\"right\":\"0\",\"left\":\"0\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}}},\"textColor\":\"ast-global-color-4\"} -->\n<div class=\"wp-block-noorifa-core-hero has-text-align-left has-ast-global-color-4-color has-text-color has-link-color\" style=\"margin-right:0;margin-left:0;padding-top:7.95rem;padding-right:0rem;padding-bottom:7.95rem;padding-left:0rem;background-image:url(http://localhost/noorblocks/wp-content/uploads/2026/07/backpack-hero.webp);background-size:cover;background-position:center;position:relative\"><div class=\"noorifa-core-hero__overlay\" style=\"background-color:#000000;opacity:0.39\"></div><div class=\"noorifa-core-hero__content is-boxed\" style=\"max-width:930px\"><h1 class=\"noorifa-core-hero__heading\" style=\"font-size:52px\"><strong>Crafted for Style<br>Built for Everyday</strong></h1><p class=\"noorifa-core-hero__subheading\" style=\"font-size:20px\">A perfect blend for elegance and style</p><div class=\"noorifa-core-hero__actions\"><!-- wp:noorifa-core/button {\"url\":\"#\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-2\"}}}},\"backgroundColor\":\"ast-global-color-5\",\"textColor\":\"ast-global-color-2\"} -->\n<div class=\"wp-block-noorifa-core-button\"><a class=\"wp-block-noorifa-core-button noorifa-core-button__link has-ast-global-color-2-color has-ast-global-color-5-background-color has-text-color has-background has-link-color\" href=\"#\"><strong>BUY NOW</strong></a></div>\n<!-- /wp:noorifa-core/button --></div></div></div>\n<!-- /wp:noorifa-core/hero -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/review-carousel {\"productId\":189,\"selectedReviews\":[61,60,59,58,57]} /-->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"}} -->\n<div class=\"wp-block-group\" style=\"padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"padding\":{\"right\":\"0\",\"left\":\"0\"}}}} -->\n<div class=\"wp-block-columns\" style=\"padding-right:0;padding-left:0\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-gallery-carousel /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"0.5rem\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:noorifa-core/product-category /-->\n\n<!-- wp:noorifa-core/product-title {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorifa-core/product-rating {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorifa-core/product-price {\"style\":{\"typography\":{\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorifa-core/product-short-description {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorifa-core/product-add-to-cart {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}}} /-->\n\n<!-- wp:noorifa-core/trust-badges {\"items\":[{\"icon\":\"shipping\",\"label\":\"Free Shipping\"},{\"icon\":\"keyboardReturn\",\"label\":\"Free Returns\"},{\"icon\":\"helpFilled\",\"label\":\"Support Online\"},{\"icon\":\"payment\",\"label\":\"Secure Payment\"}]} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|80\",\"bottom\":\"var:preset|spacing|80\",\"left\":\"0\",\"right\":\"0\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--80);padding-right:0;padding-bottom:var(--wp--preset--spacing--80);padding-left:0\"><!-- wp:media-text {\"mediaId\":191,\"mediaLink\":\"http://localhost/noorblocks/?attachment_id=191\",\"linkDestination\":\"none\",\"mediaType\":\"image\",\"mediaWidth\":46} -->\n<div class=\"wp-block-media-text is-stacked-on-mobile\" style=\"grid-template-columns:46% auto\"><figure class=\"wp-block-media-text__media\"><img src=\"http://localhost/noorblocks/wp-content/uploads/2026/07/bag7_3.webp\" alt=\"\" class=\"wp-image-191 size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><strong>Customer Favorite</strong></h3>\n<!-- /wp:heading -->\n\n<!-- wp:noorifa-core/heading {\"style\":{\"typography\":{\"fontSize\":\"48px\",\"lineHeight\":\"1.1\",\"fontWeight\":\"700\"}}} -->\n<h2 class=\"wp-block-noorifa-core-heading\" style=\"font-size:48px;font-weight:700;line-height:1.1\">Minimal by Design Powerful in Presence</h2>\n<!-- /wp:noorifa-core/heading -->\n\n<!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\">Elevate your product pages without touching a single line of code. Noorifa Core gives you a full library of premade WooCommerce layouts and conversion-ready blocks — gallery, tabs, reviews, urgency countdowns and more — so your store looks this good in minutes, not weeks.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:media-text --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-tabs /-->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorifa-core/product-reviews /-->\n\n<!-- wp:spacer {\"height\":\"57px\"} -->\n<div style=\"height:57px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|20\",\"right\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--20);padding-right:var(--wp--preset--spacing--20);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--20)\"><!-- wp:noorifa-core/related-products {\"columns\":3,\"fontSize\":\"medium\"} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->"
