{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "noorifa-core/marquee",
	"title": "Marquee",
	"category": "noorifa-core",
	"icon": "megaphone",
	"description": "A row of short text items that scrolls infinitely across the screen — great for promos, announcements or shipping perks.",
	"keywords": [ "marquee", "ticker", "scroll", "announcement", "promo" ],
	"version": "1.0.0",
	"textdomain": "noorifa-core",
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{ "text": "Free shipping on orders over $200" },
				{ "text": "30-day money-back guarantee" },
				{ "text": "Trusted by 200,000+ happy customers" }
			]
		},
		"speed": {
			"type": "number",
			"default": 20
		},
		"direction": {
			"type": "string",
			"default": "left"
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"gap": {
			"type": "number",
			"default": 48
		},
		"separator": {
			"type": "string",
			"default": "✦"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
