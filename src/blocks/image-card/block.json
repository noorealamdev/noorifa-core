{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "noorifa-core/image-card",
	"title": "Image Card",
	"category": "noorifa-core",
	"icon": "cover-image",
	"description": "A grid of promo cards — each a background image with an overlaid heading, subtext and a call-to-action link.",
	"keywords": [ "promo", "banner", "image", "card", "cta" ],
	"version": "1.0.0",
	"textdomain": "noorifa-core",
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{
					"imageId": 0,
					"imageUrl": "",
					"heading": "Table Lamp Sale",
					"subheading": "Up to 50% Off Bestsellers.",
					"linkText": "Shop Now",
					"linkUrl": "#",
					"textColor": "",
					"overlay": 0
				},
				{
					"imageId": 0,
					"imageUrl": "",
					"heading": "Hear Every Detail",
					"subheading": "Power comfort clarity",
					"linkText": "Shop Now",
					"linkUrl": "#",
					"textColor": "#ffffff",
					"overlay": 25
				}
			]
		},
		"columns": {
			"type": "number",
			"default": 2
		},
		"minHeight": {
			"type": "number",
			"default": 480
		},
		"verticalAlign": {
			"type": "string",
			"default": "center"
		},
		"textAlign": {
			"type": "string",
			"default": "left"
		},
		"boxed": {
			"type": "boolean",
			"default": true
		},
		"boxedWidth": {
			"type": "number",
			"default": 1200
		},
		"borderRadius": {
			"type": "number",
			"default": 0
		},
		"subheadingFontSize": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
