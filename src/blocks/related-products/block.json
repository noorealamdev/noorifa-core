{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "noorifa-core/related-products",
    "title": "Related Products",
    "category": "noorifa-core",
    "icon": "networking",
    "description": "Displays WooCommerce's related products for the current product.",
    "keywords": [
        "woocommerce",
        "product",
        "related",
        "cross-sell"
    ],
    "version": "1.0.0",
    "textdomain": "noorifa-core",
    "attributes": {
        "productsToShow": {
            "type": "number",
            "default": 4
        },
        "columns": {
            "type": "number",
            "default": 4
        },
        "boxed": {
            "type": "boolean",
            "default": true
        },
        "boxedWidth": {
            "type": "number",
            "default": 1200
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "anchor": true,
        "html": false,
        "color": {
            "background": true,
            "text": true,
            "gradients": true
        },
        "typography": {
            "fontSize": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "__experimentalBorder": {
            "radius": true,
            "width": true,
            "color": true
        },
        "shadow": true
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
