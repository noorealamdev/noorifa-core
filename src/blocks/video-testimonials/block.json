{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "noorifa-core/video-testimonials",
	"title": "Video Testimonials",
	"category": "noorifa-core",
	"icon": "format-video",
	"description": "A grid or carousel of video testimonials — each a YouTube/Vimeo link or an uploaded clip, shown as a poster with a play button that only loads the video on click.",
	"keywords": [ "video", "testimonial", "review", "customer", "carousel" ],
	"version": "1.0.0",
	"textdomain": "noorifa-core",
	"attributes": {
		"items": {
			"type": "array",
			"default": [
				{
					"videoType": "url",
					"videoUrl": "",
					"videoFileId": 0,
					"videoFileUrl": "",
					"posterId": 0,
					"posterUrl": "",
					"name": "Customer name",
					"role": "Verified buyer",
					"quote": "Share what this customer loved in a sentence or two."
				}
			]
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"cardBackground": {
			"type": "string",
			"default": ""
		},
		"boxed": {
			"type": "boolean",
			"default": true
		},
		"boxedWidth": {
			"type": "number",
			"default": 1200
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
